{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["creators", "access_right"],
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "language": { "type": "string" },
    "license": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string" }
          }
        }
      ]
    },
    "upload_type": {
      "type": "string",
      "enum": ["publication", "poster", "presentation", "dataset", "image", "video", "software", "lesson", "other"]
    },
    "publication_type": { "type": "string" },
    "access_right": {
      "type": "string",
      "enum": ["open", "embargoed", "restricted", "closed"]
    },
    "creators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "affiliation": { "type": "string" },
          "orcid": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "affiliation": { "type": "string" },
          "orcid": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "relation"],
        "properties": {
          "identifier": { "type": "string" },
          "relation": { "type": "string" },
          "resource_type": { "type": "string" },
          "scheme": { "type": "string" }
        }
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { 
          "id": { "type": "string" } 
        }
      }
    },
    "communities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { 
          "identifier": { "type": "string" } 
        }
      }
    },
    "doi": { "type": "string" },
    "prereserve_doi": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
